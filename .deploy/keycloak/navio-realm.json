{
  "realm": "navio",
  "enabled": true,
  "displayName": "Navio",
  "loginTheme": "navio",
  "sslRequired": "${KEYCLOAK_SSL_REQUIRED:all}",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": "${KEYCLOAK_VERIFY_EMAIL:true}",
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,

  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",

  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard Navio user."
      },
      {
        "name": "MODERATOR",
        "description": "May suspend and reactivate standard user accounts."
      },
      {
        "name": "ADMIN",
        "description": "May grant and revoke global roles, and moderate privileged accounts."
      }
    ]
  },

  "defaultRoles": ["USER"],

  "clients": [
    {
      "clientId": "navio-web",
      "name": "Navio Web Client",
      "description": "Browser front end. Authorization code flow with PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "secret": "${KEYCLOAK_WEB_CLIENT_SECRET}",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "${NAVIO_WEB_ORIGIN}/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "${NAVIO_WEB_ORIGIN}"
      ],
      "protocolMappers": [
        {
          "name": "navio-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "navio-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },

    {
      "clientId": "navio-api",
      "name": "Navio API",
      "description": "Audience identifier for the Navio backend. Never used to log in.",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },

    {
      "clientId": "navio-user-management",
      "name": "Navio User Management Service Account",
      "description": "Confidential client for Keycloak Admin API calls made by the user management service.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}"
    }
  ],

  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],

  "users": [
    {
      "username": "service-account-navio-user-management",
      "enabled": true,
      "serviceAccountClientId": "navio-user-management",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],

  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xFrameOptions": "SAMEORIGIN",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },

  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
