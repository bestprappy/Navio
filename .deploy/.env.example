NAVIO_IMAGE_PREFIX=ghcr.io/bestprappy/navio
NAVIO_IMAGE_TAG=replace-with-a-git-commit-sha

# --- Database ---------------------------------------------------------------
POSTGRES_DB=tripplanner
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=replace-with-a-long-random-password
USER_DB_PASSWORD=replace-with-a-long-random-password

# --- Keycloak: bootstrap admin (console login) ------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Keycloak: token validation ---------------------------------------------
# Issuer of the realm. Every service rejects tokens whose 'iss' differs, so this
# must match exactly what Keycloak puts in the token — including scheme and any
# path prefix. A trailing slash mismatch will fail every request.
KEYCLOAK_PUBLIC_URL=https://navio.sit.kmutt.ac.th
KEYCLOAK_ISSUER_URI=https://navio.sit.kmutt.ac.th/realms/navio
KEYCLOAK_BASE_URL=https://navio.sit.kmutt.ac.th
KEYCLOAK_REALM=navio

# Origin the web client is served from. The client runs on Vercel, so this is
# NOT this host. It is substituted into the navio-web redirect URI and web
# origin when the realm is imported (see .deploy/keycloak/navio-realm.json), so
# a wrong value here means Keycloak rejects the login callback.
# Replace <project> with the Vercel production domain.
NAVIO_WEB_ORIGIN=https://<project>.vercel.app

# Accepted 'aud' values, comma-separated. Requires the Audience protocol mapper
# on the navio-web client (see .deploy/keycloak/navio-realm.json). Without that
# mapper Keycloak emits only "aud": "account" and every token is rejected.
KEYCLOAK_AUDIENCES=navio-api

# --- Keycloak: Auth.js web client -------------------------------------------
# Must also be configured as AUTH_KEYCLOAK_SECRET in the Next.js deployment.
KEYCLOAK_WEB_CLIENT_SECRET=replace-with-a-different-long-random-secret

# --- Keycloak: user management service account ------------------------------
# Confidential client the user management service uses for Admin API calls
# (disable/enable an account, grant/revoke a realm role).
# Grant it ONLY manage-users and view-users from realm-management — never
# realm-admin. Generate a fresh secret per environment; never reuse across envs.
KEYCLOAK_ADMIN_CLIENT_ID=navio-user-management
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-the-client-secret-from-keycloak

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the gateway. Must not be "*":
# the gateway sends credentials, and a wildcard would let any site issue
# authenticated cross-origin requests on a signed-in user's behalf.
#
# The Next.js client proxies every /v1/** call server-side, so the browser does
# not currently make cross-origin requests to the gateway at all and this list
# is defence in depth rather than load-bearing. Keep it accurate anyway: if any
# future feature calls the gateway from browser code, this is what permits it.
NAVIO_CORS_ALLOWED_ORIGINS=https://<project>.vercel.app

# --- Messaging --------------------------------------------------------------
KAFKA_CLUSTER_ID=885sUBCQTzGwY-lF8YV-uQ

# --- Third party ------------------------------------------------------------
GOOGLE_MAPS_SERVER_API_KEY=

# --- Observability ----------------------------------------------------------
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=https://navio.sit.kmutt.ac.th/grafana/
