NAVIO_IMAGE_PREFIX=ghcr.io/bestprappy/navio
# Rewritten by deploy.sh on every run from the deploying commit SHA. The value
# below is only a placeholder — do not maintain it by hand.
NAVIO_IMAGE_TAG=replace-with-a-git-commit-sha

# --- Database ---------------------------------------------------------------
POSTGRES_DB=tripplanner
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Note: the user management service's USER_DB_PASSWORD is supplied by Compose
# from POSTGRES_PASSWORD above — it is deliberately not a separate entry here.
# Setting one would have no effect.

# --- Keycloak: bootstrap admin (console login) ------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Keycloak: token validation ---------------------------------------------
# Issuer of the realm. Every service rejects tokens whose 'iss' differs, so this
# must match exactly what Keycloak puts in the token — including scheme and any
# path prefix. A trailing slash mismatch will fail every request.
KEYCLOAK_PUBLIC_URL=https://navio.sit.kmutt.ac.th
KEYCLOAK_ISSUER_URI=https://navio.sit.kmutt.ac.th/realms/navio
KEYCLOAK_BASE_URL=https://navio.sit.kmutt.ac.th
KEYCLOAK_REALM=navio

# Origin the web client is served from. The Next.js client runs in this same
# stack behind NGINX, so it shares this host. It is substituted into the
# navio-web redirect URI and web origin when the realm is imported (see
# .deploy/keycloak/navio-realm.json), and it is also the client's AUTH_URL, so
# a wrong value here means Keycloak rejects the login callback.
NAVIO_WEB_ORIGIN=https://navio.sit.kmutt.ac.th

# --- Next.js client ---------------------------------------------------------
# Signs and encrypts the client's session cookie. Generate a dedicated value
# with `openssl rand -hex 32`; rotating it signs every user out.
AUTH_SECRET=replace-with-a-long-random-secret

# Accepted 'aud' values, comma-separated. Requires the Audience protocol mapper
# on the navio-web client (see .deploy/keycloak/navio-realm.json). Without that
# mapper Keycloak emits only "aud": "account" and every token is rejected.
KEYCLOAK_AUDIENCES=navio-api

# --- Keycloak: Auth.js web client -------------------------------------------
# Compose passes these to the navio-web container as AUTH_KEYCLOAK_ID and
# AUTH_KEYCLOAK_SECRET. The secret is also what Keycloak imports for the
# navio-web client, so both sides always agree.
KEYCLOAK_WEB_CLIENT_ID=navio-web
KEYCLOAK_WEB_CLIENT_SECRET=replace-with-a-different-long-random-secret

# --- Google OAuth: sign-in provider ----------------------------------------
# Create a Google Cloud OAuth 2.0 Client ID of type "Web application". This is
# separate from every Maps API key. Configure this exact authorized redirect:
# https://navio.sit.kmutt.ac.th/realms/navio/broker/google/endpoint
# These values are passed only to the server-side identity broker and must
# never use a NEXT_PUBLIC_ prefix or be committed with real credentials.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# --- Keycloak: user management service account ------------------------------
# Confidential client the user management service uses for Admin API calls
# (disable/enable an account, grant/revoke a realm role).
# Grant it ONLY manage-users and view-users from realm-management — never
# realm-admin. Generate a fresh secret per environment; never reuse across envs.
KEYCLOAK_ADMIN_CLIENT_ID=navio-user-management
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-the-client-secret-from-keycloak

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the gateway. Must not be "*":
# the gateway sends credentials, and a wildcard would let any site issue
# authenticated cross-origin requests on a signed-in user's behalf.
#
# The Next.js client proxies every /v1/** call server-side and is served from
# this same origin, so the browser makes no cross-origin request to the gateway
# at all and this list is defence in depth rather than load-bearing. Keep it
# accurate anyway: if any future feature calls the gateway from browser code,
# this is what permits it.
NAVIO_CORS_ALLOWED_ORIGINS=https://navio.sit.kmutt.ac.th

# --- Messaging --------------------------------------------------------------
KAFKA_CLUSTER_ID=885sUBCQTzGwY-lF8YV-uQ

# --- Third party ------------------------------------------------------------
# Required by Mobility & EV. Use a server-side key restricted to Places API
# (New), Routes API, and the production server's outbound IP. Do not reuse the
# browser-exposed NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Observability ----------------------------------------------------------
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=https://navio.sit.kmutt.ac.th/grafana/
