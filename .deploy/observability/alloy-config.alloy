// ============================================================================
// Grafana Alloy Configuration for Navio Production
// ============================================================================
// Every Navio service runs as a container on this VM, so container stdout is
// the only log source. There is no host-run Java service log directory here.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	forward_to    = [loki.write.default.receiver]
	relabel_rules = discovery.relabel.containers.rules
	labels        = {
		cluster     = "navio",
		environment = "production",
		platform    = "docker",
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// ============================================================================
// Traces: services -> Alloy (Zipkin) -> Tempo (OTLP)
// ============================================================================
// Services keep their Zipkin exporter. Prometheus scrapes and container health
// checks hit /actuator on every service, and each of those requests starts its
// own trace. Left in, they draw a fake "user -> <service>" edge for every
// service on the service graph, so they are dropped here before Tempo sees them.

otelcol.receiver.zipkin "services" {
	endpoint = "0.0.0.0:9411"

	output {
		traces = [otelcol.processor.filter.probes.input]
	}
}

otelcol.processor.filter "probes" {
	error_mode = "ignore"

	traces {
		span = [
			`IsMatch(name, "^http [a-z]+ /actuator")`,
			`attributes["uri"] != nil and IsMatch(attributes["uri"], "^/actuator")`,
		]
	}

	output {
		traces = [otelcol.processor.batch.traces.input]
	}
}

otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

// ============================================================================
// Alloy Server Configuration
// ============================================================================

logging {
	level = "warn"
}
