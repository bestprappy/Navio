{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\"}",
        "iconColor": "red",
        "name": "Firing alerts",
        "tagKeys": "alertname,severity,service",
        "textFormat": "{{alertname}}: {{service}}",
        "titleFormat": "Firing alert"
      }
    ]
  },
  "description": "Production operations dashboard for Navio services. RED, SLO, JVM, database, Kafka, and correlated Loki log signals.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Prometheus targets",
      "type": "link",
      "url": "http://localhost:9090/targets"
    },
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Zipkin traces",
      "type": "link",
      "url": "http://localhost:9411/zipkin/"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of selected Navio service scrape targets currently reachable by Prometheus.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 100 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "100 * sum(up{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",job=~\"api-gateway|config-server|discovery-server|trip-planning-service|user-management-service|mobility-and-ev-service|community-service\"} == 1) / count(up{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",job=~\"api-gateway|config-server|discovery-server|trip-planning-service|user-management-service|mobility-and-ev-service|community-service\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Services healthy",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Application request throughput. Actuator traffic is excluded.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of application requests returning an HTTP 5xx response.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Server error rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95th-percentile application request duration from Micrometer histogram buckets.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "title": "p95 latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Remaining error budget for a 99.9% availability objective over the selected dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "clamp_max(clamp_min(100 * (1 - ((((sum(increase(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__range]))) or vector(0)) / sum(increase(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__range]))) / 0.001)), 0), 100)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Error budget remaining",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus alert rules currently firing for the selected Navio services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\",cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active alerts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 100,
      "panels": [],
      "title": "Availability and SLO (99.9%)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "A value of 1 is reachable and 0 is unreachable. Gaps mean Prometheus has no series for the selected service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "stepAfter", "lineWidth": 2, "pointSize": 3, "showPoints": "never", "spanNulls": false },
          "max": 1,
          "min": 0,
          "unit": "bool_on_off"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "up{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",job=~\"api-gateway|config-server|discovery-server|trip-planning-service|user-management-service|mobility-and-ev-service|community-service\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Service health",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Availability is the percentage of non-5xx application requests, grouped by service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "pointSize": 3, "showPoints": "never", "spanNulls": false },
          "decimals": 3,
          "max": 100,
          "min": 99,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99.9 }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "asc" }
      },
      "targets": [
        {
          "expr": "100 * (1 - (((sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval]))) or on (service) (0 * sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))) / sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Request availability",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Error rate divided by the 0.1% budget. A sustained value above 1 consumes budget faster than the 99.9% SLO allows.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 3, "showPoints": "never", "spanNulls": false },
          "decimals": 2,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 14.4 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "(((sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[1h]))) or on (service) (0 * sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[1h])))) / sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[1h]))) / 0.001",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "1h error-budget burn rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 101,
      "panels": [],
      "title": "Traffic, errors, and critical routes",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Application request throughput by service; health and metrics endpoints are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 3, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Requests by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Application requests split by HTTP response status.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 1, "pointSize": 3, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "Response status distribution",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requests handled by Spring Cloud Gateway routes. This highlights traffic reaching Navio's user-facing backend routes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 3, "showPoints": "never" },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (routeId, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{routeId}} · {{httpStatusCode}}",
          "refId": "A"
        }
      ],
      "title": "Gateway routes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Highest-volume application endpoints in the selected period.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "pointSize": 3, "showPoints": "never" },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (service, method, uri) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*|UNKNOWN|NOT_FOUND\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · {{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Top endpoints",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "5xx response rate by application endpoint. A blank chart means no server errors were observed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 3, "showPoints": "never" },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (service, method, uri, status) (rate(http_server_requests_seconds_count{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · {{method}} {{uri}} · {{status}}",
          "refId": "A"
        }
      ],
      "title": "Failing endpoints",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 102,
      "panels": [],
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Overall application latency distribution. Percentiles require Micrometer histogram buckets.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2, "pointSize": 3, "showPoints": "never" },
          "decimals": 3,
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 15,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\",service=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95th-percentile application request duration by service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "pointSize": 3, "showPoints": "never" },
          "decimals": 3,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] },
          "unit": "s"
        },
