    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate by edge",
      "description": "Sampled calls per second on each caller -> callee edge over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No sampled traffic in this range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{$infra}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{client}} → {{server}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed calls by edge",
      "description": "Sampled failed calls per second on each edge. Empty means nothing failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No failed calls",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{$infra}[$__rate_interval])) > 0",
          "refId": "A",
          "range": true,
          "legendFormat": "{{client}} → {{server}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "navio",
    "production",
    "tracing",
    "service-graph"
  ],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "infra",
        "label": "Infrastructure calls",
        "description": "Hide Eureka and Config Server calls (registry heartbeats and config fetches) so the graph shows only request traffic.",
        "query": "Hide : server!~\"eureka|discovery-server|config-server\",Show : server=~\".+\"",
        "current": {
          "selected": true,
          "text": "Hide",
          "value": "server!~\"eureka|discovery-server|config-server\""
        },
        "options": [
          {
            "selected": true,
            "text": "Hide",
            "value": "server!~\"eureka|discovery-server|config-server\""
          },
          {
            "selected": false,
            "text": "Show",
            "value": "server=~\".+\""
          }
