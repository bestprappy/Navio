          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",service!~\"api-gateway|eureka|discovery-server|config-server\",status_code=\"STATUS_CODE_ERROR\"}[$__range])) or (0 * sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",service!~\"api-gateway|eureka|discovery-server|config-server\"}[$__range])))) / sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",service!~\"api-gateway|eureka|discovery-server|config-server\"}[$__range]))",
