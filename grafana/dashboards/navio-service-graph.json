        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Req/s",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",service!~\"api-gateway|eureka|discovery-server|config-server\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
